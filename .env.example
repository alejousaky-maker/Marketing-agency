DATABASE_URL=postgresql://agencyos:agencyos_local@localhost:54329/agencyos
APP_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_PATH=.data/storage
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TESSERACT_PATH=tesseract
# Optional live multimodal analysis and transcription; never commit actual keys.
OPENAI_API_KEY=
# Cloud secret binding aliases (use these where OPENAI_* names are reserved).
AGENCYOS_AI_KEY=
AGENCYOS_SEARCH_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=whisper-1
# Optional current public web search. Public URL evidence also works without a key.
BRAVE_SEARCH_API_KEY=
# In managed proxy environments, approve exact research hosts in both this list
# and the environment egress policy. The trusted proxy must block private networks.
RESEARCH_USE_ENV_PROXY=false
RESEARCH_ALLOWED_HOSTS=
# Required only for STORAGE_DRIVER=s3. Keep buckets private.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local demo credentials are generated by setup.sh; set an explicit password for seed elsewhere.
DEMO_EMAIL=demo@agencyos.local
DEMO_PASSWORD=
DEMO_MODE=false
