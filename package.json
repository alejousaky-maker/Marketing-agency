{
  "name": "agencyos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "https-proxy-agent": "^9.1.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
